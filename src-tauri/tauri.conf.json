{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devventory",
  "version": "../package.json",
  "identifier": "com.paul.devventory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devventory",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNEJDNzEyQTBDQUE4N0IKUldSN3FNcWdFc2RMSGdFdWRhTmhxc1BKY1lGOGFtRk9BYXI3Rnovd0JmT3NwemhDcXErSFcyK0gK",
      "endpoints": [
        "https://github.com/kuyajp123/devventory-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
